# Production environment for docker-compose.
# Copy to .env.prod next to docker-compose.yml and fill in the secrets.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Hostname(s)/IP(s) the app is reached on, comma-separated
DJANGO_ALLOWED_HOSTS=vpn.example.com
# Origins allowed to POST, scheme + host (+port if non-standard),
# e.g. http://10.0.0.5:8000 while running plain HTTP
DJANGO_CSRF_TRUSTED_ORIGINS=http://vpn.example.com:8000

# No TLS certificate yet — serve plain HTTP. Once a TLS-terminating proxy is
# in front: set this to True and switch the CSRF origins above to https://.
DJANGO_SECURE_SSL_REDIRECT=False

# --- Database (the db service reads POSTGRES_*, Django reads DATABASE_URL) ---
POSTGRES_DB=vpn_platform
POSTGRES_USER=vpn_platform
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://vpn_platform:change-me@db:5432/vpn_platform

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Frontend (assets are baked into the image) ---
DJANGO_VITE_DEV_MODE=False

# --- Optional: create an admin account on first boot ---
#DJANGO_SUPERUSER_USERNAME=admin
#DJANGO_SUPERUSER_EMAIL=admin@example.com
#DJANGO_SUPERUSER_PASSWORD=change-me
